{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main history window: full app access",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-recorder-state",
    "allow-recorder-start",
    "allow-recorder-stop",
    "allow-recorder-pause",
    "allow-recorder-resume",
    "allow-show-main-window",
    "allow-app-info",
    "allow-get-setting",
    "allow-set-setting",
    "allow-list-meetings",
    "allow-reveal-meeting",
    "allow-get-meeting",
    "allow-rename-meeting",
    "allow-delete-meeting",
    "allow-retranscribe-meeting",
    "allow-search-transcripts",
    "allow-list-models",
    "allow-download-model",
    "allow-delete-model",
    "allow-transcription-status",
    "allow-tracking-status",
    "allow-request-tracking-permission",
    "allow-day-report",
    "allow-range-report",
    "allow-delete-day-activity",
    "allow-list-projects",
    "allow-save-project",
    "allow-delete-project",
    "allow-get-timesheet",
    "allow-save-timesheet",
    "allow-reset-timesheet",
    "allow-export-timesheet",
    "allow-get-notes",
    "allow-generate-notes",
    "allow-save-notes",
    "allow-set-notes-key",
    "allow-has-notes-key",
    "allow-day-action-items",
    "allow-backup-now",
    "allow-restore-backup",
    "allow-import-v1-status",
    "allow-run-import-v1",
    "allow-recordings-folder",
    "dialog:allow-open",
    "allow-check-notes-provider"
  ]
}

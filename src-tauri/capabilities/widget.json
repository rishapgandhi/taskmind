{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "Floating recorder: recorder controls only",
  "windows": ["widget"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "allow-recorder-state",
    "allow-recorder-start",
    "allow-recorder-stop",
    "allow-recorder-pause",
    "allow-recorder-resume",
    "allow-show-main-window"
  ]
}
